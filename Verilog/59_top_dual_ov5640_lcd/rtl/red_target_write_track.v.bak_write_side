`timescale 1ns/1ps
//------------------------------------------------------------------------------
// red_target_write_track
//   Detects the red target while the camera frame is being written.
//   The generated metadata is stored in a two-entry dual-clock RAM using the
//   same ping-pong page index as the DDR3 frame buffer.
//------------------------------------------------------------------------------
module red_target_write_track #(
    parameter integer MIN_RED_PIX = 8
)(
    input  wire        clk,
    input  wire        rst_n,
    input  wire        vsync,
    input  wire        de,
    input  wire [15:0] din,
    input  wire [10:0] h_disp,
    input  wire [10:0] v_disp,
    output reg  [10:0] meta_cx,
    output reg  [10:0] meta_cy,
    output reg         meta_valid,
    output reg         meta_we,
    output reg         wr_page
);

    localparam [10:0] SEARCH_INIT_W = 11'd70;
    localparam [10:0] SEARCH_INIT_H = 11'd70;
    localparam [10:0] SEARCH_MIN_W  = 11'd50;
    localparam [10:0] SEARCH_MIN_H  = 11'd50;
    localparam [10:0] SEARCH_MAX_W  = 11'd120;
    localparam [10:0] SEARCH_MAX_H  = 11'd120;
    localparam [10:0] SEARCH_STEP   = 11'd8;

    wire [4:0] r5 = din[15:11];
    wire [5:0] g6 = din[10:5];
    wire [4:0] b5 = din[4:0];
    wire [7:0] r8 = {r5, r5[4:2]};
    wire [7:0] g8 = {g6, g6[5:4]};
    wire [7:0] b8 = {b5, b5[4:2]};

    wire signed [11:0] cb_calc = 12'sd128
        - $signed({4'b0, r8[7:1]})
        - $signed({4'b0, g8[7:2]})
        + $signed({4'b0, b8[7:1]});
    wire signed [11:0] cr_calc = 12'sd128
        + $signed({4'b0, r8[7:1]})
        - $signed({4'b0, g8[7:3]})
        - $signed({4'b0, b8[7:4]});
    wire [7:0] cb8 = (cb_calc < 0) ? 8'd0 :
                     ((cb_calc > 12'sd255) ? 8'd255 : cb_calc[7:0]);
    wire [7:0] cr8 = (cr_calc < 0) ? 8'd0 :
                     ((cr_calc > 12'sd255) ? 8'd255 : cr_calc[7:0]);

    wire red_pix = (cr8 >= 8'd150) &&
                   (cb8 <= 8'd120) &&
                   (cr8 > (cb8 + 8'd40));

    reg        vsync_d;
    wire       frame_start = vsync & ~vsync_d;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            vsync_d <= 1'b0;
        else
            vsync_d <= vsync;
    end

    reg  [10:0] x_cnt;
    reg  [10:0] y_cnt;
    wire        last_x = (x_cnt == (h_disp - 11'd1));
    wire        last_y = (y_cnt == (v_disp - 11'd1));
    wire        frame_last = de && last_x && last_y;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            x_cnt <= 11'd0;
            y_cnt <= 11'd0;
        end
        else if (frame_start) begin
            x_cnt <= 11'd0;
            y_cnt <= 11'd0;
        end
        else if (de) begin
            if (last_x) begin
                x_cnt <= 11'd0;
                if (last_y)
                    y_cnt <= 11'd0;
                else
                    y_cnt <= y_cnt + 11'd1;
            end
            else begin
                x_cnt <= x_cnt + 11'd1;
            end
        end
    end

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            wr_page <= 1'b1;
        else if (frame_start)
            wr_page <= ~wr_page;
    end

    reg [10:0] minx, maxx, miny, maxy;
    reg [15:0] pix_count;
    reg        seen;
    reg [10:0] prev_cx, prev_cy;
    reg        have_prev;
    reg [2:0]  miss_count;
    reg [10:0] search_w, search_h;

    wire [11:0] x12 = {1'b0, x_cnt};
    wire [11:0] y12 = {1'b0, y_cnt};
    wire [11:0] px12 = {1'b0, prev_cx};
    wire [11:0] py12 = {1'b0, prev_cy};
    wire [11:0] sw12 = {1'b0, search_w};
    wire [11:0] sh12 = {1'b0, search_h};
    wire [11:0] h12  = {1'b0, h_disp};
    wire [11:0] v12  = {1'b0, v_disp};

    wire [11:0] search_x0 = (px12 > sw12) ? (px12 - sw12) : 12'd0;
    wire [11:0] search_x1 = px12 + sw12;
    wire [11:0] search_y0 = (py12 > sh12) ? (py12 - sh12) : 12'd0;
    wire [11:0] search_y1 = py12 + sh12;
    wire        central_ok = (x12 >= (h12 >> 3)) &&
                             (x12 <= (h12 - (h12 >> 3))) &&
                             (y12 >= (v12 >> 3)) &&
                             (y12 <= (v12 - (v12 >> 3)));
    wire        in_search = have_prev ?
                            ((x12 >= search_x0) && (x12 <= search_x1) &&
                             (y12 >= search_y0) && (y12 <= search_y1)) :
                            central_ok;
    wire        accept_pixel = de && red_pix && in_search;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            minx <= 11'h7FF; maxx <= 11'd0;
            miny <= 11'h7FF; maxy <= 11'd0;
            pix_count <= 16'd0;
            seen <= 1'b0;
        end
        else if (frame_start) begin
            minx <= 11'h7FF; maxx <= 11'd0;
            miny <= 11'h7FF; maxy <= 11'd0;
            pix_count <= 16'd0;
            seen <= 1'b0;
        end
        else if (accept_pixel) begin
            pix_count <= pix_count + 16'd1;
            if (!seen) begin
                minx <= x_cnt; maxx <= x_cnt;
                miny <= y_cnt; maxy <= y_cnt;
                seen <= 1'b1;
            end
            else begin
                if (x_cnt < minx) minx <= x_cnt;
                if (x_cnt > maxx) maxx <= x_cnt;
                if (y_cnt < miny) miny <= y_cnt;
                if (y_cnt > maxy) maxy <= y_cnt;
            end
        end
    end

    wire [11:0] det_cx = ({1'b0, minx} + {1'b0, maxx}) >> 1;
    wire [11:0] det_cy = ({1'b0, miny} + {1'b0, maxy}) >> 1;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            meta_cx <= 11'd0;
            meta_cy <= 11'd0;
            meta_valid <= 1'b0;
            meta_we <= 1'b0;
            prev_cx <= 11'd0;
            prev_cy <= 11'd0;
            have_prev <= 1'b0;
            miss_count <= 3'd0;
            search_w <= SEARCH_INIT_W;
            search_h <= SEARCH_INIT_H;
        end
        else begin
            meta_we <= frame_last;

            if (frame_last) begin
                if (seen && (pix_count >= MIN_RED_PIX)) begin
                    meta_cx <= det_cx[10:0];
                    meta_cy <= det_cy[10:0];
                    meta_valid <= 1'b1;
                    prev_cx <= det_cx[10:0];
                    prev_cy <= det_cy[10:0];
                    have_prev <= 1'b1;
                    miss_count <= 3'd0;
                    if (search_w > SEARCH_MIN_W) search_w <= search_w - SEARCH_STEP;
                    if (search_h > SEARCH_MIN_H) search_h <= search_h - SEARCH_STEP;
                end
                else begin
                    meta_cx <= 11'd0;
                    meta_cy <= 11'd0;
                    meta_valid <= 1'b0;
                    if (have_prev && (miss_count < 3'd2)) begin
                        miss_count <= miss_count + 3'd1;
                        if (search_w < SEARCH_MAX_W) search_w <= search_w + SEARCH_STEP;
                        if (search_h < SEARCH_MAX_H) search_h <= search_h + SEARCH_STEP;
                    end
                    else begin
                        have_prev <= 1'b0;
                        miss_count <= 3'd0;
                        search_w <= SEARCH_MAX_W;
                        search_h <= SEARCH_MAX_H;
                    end
                end
            end
        end
    end

endmodule


module meta_dual_ram #(
    parameter integer WIDTH = 23
)(
    input  wire             wr_clk,
    input  wire             wr_en,
    input  wire [0:0]       wr_addr,
    input  wire [WIDTH-1:0] wr_data,
    input  wire             rd_clk,
    input  wire [0:0]       rd_addr,
    output reg  [WIDTH-1:0] rd_data
);

    reg [WIDTH-1:0] mem [0:1];
    integer i;

    initial begin
        for (i = 0; i < 2; i = i + 1)
            mem[i] = {WIDTH{1'b0}};
    end

    always @(posedge wr_clk) begin
        if (wr_en)
            mem[wr_addr] <= wr_data;
    end

    always @(posedge rd_clk) begin
        rd_data <= mem[rd_addr];
    end

endmodule